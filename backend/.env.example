# Copiar como backend/.env y completar. Este archivo de ejemplo no contiene secretos reales.
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/vetconnect
SECRET_KEY=cambia-esto-por-una-clave-larga-y-aleatoria
ACCESS_TOKEN_EXPIRE_MINUTES=120
CORS_ORIGINS=http://localhost:4200

# SMTP opcional (VET-15). Si se deja vacío, las notificaciones corren en modo demo (solo consola).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=vetconnect@vetconnect.cl
